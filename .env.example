# ─────────────────────────────────────────────
# CineHub — Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

FLASK_ENV=development

# Generate a strong random value:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# ── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://postgres:YourPassword@localhost:5432/movie_db

# ── SendGrid SMTP ─────────────────────────────
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# Scope required: Mail Send → Full Access
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# The "From" address — MUST be verified in SendGrid as a Sender Identity
# https://app.sendgrid.com/settings/sender_auth
MAIL_DEFAULT_SENDER=chintarapalliafrin@gmail.com
DATABASE_URL=postgresql://afrin:nE70hm2BdTYBax4IAJ8zALXtiVEni3L7@dpg-d85dp519rddc73a8v5e0-a.oregon-postgres.render.com/movies_4zp
# ── Local dev: set to true to actually send emails while developing ────────────
# Leave as false to suppress sending (emails will be logged but not delivered)
DEV_SEND_MAIL=false
